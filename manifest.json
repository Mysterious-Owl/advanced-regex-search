{
  "manifest_version": 3,
  "name": "Advanced Regex Search",
  "description": "A high-performance, non-destructive regex search tool for the modern web.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icons_16.png",
    "24": "icons/icons_24.png",
    "32": "icons/icons_32.png",
    "48": "icons/icons_48.png",
    "64": "icons/icons_64.png",
    "72": "icons/icons_72.png",
    "96": "icons/icons_96.png",
    "128": "icons/icons_128.png",
    "256": "icons/icons_256.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icons_16.png",
      "24": "icons/icons_24.png",
      "32": "icons/icons_32.png",
      "48": "icons/icons_48.png",
      "64": "icons/icons_64.png",
      "72": "icons/icons_72.png",
      "96": "icons/icons_96.png",
      "128": "icons/icons_128.png",
      "256": "icons/icons_256.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "js": [
        "js/common.js",
        "js/content.js"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      }
    }
  },
  "options_page": "options.html"
}
